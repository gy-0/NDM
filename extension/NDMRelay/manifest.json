{
   "action": {
      "default_icon": {
         "16": "img/icon16.png"
      }
   },
   "author": "Yuan Gao",
   "background": {
      "service_worker": "bg.js"
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "media-policy.js", "resource-policy.js", "site-adapters.js", "resource-shelf.js", "ct.js" ],
      "matches": [ "http://*/*", "https://*/*" ],
      "run_at": "document_start"
   } ],
   "description": "Relays browser downloads, media choices, and useful page resources to NDM",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "img/icon128.png",
      "16": "img/icon16.png",
      "48": "img/icon48.png"
   },
   "manifest_version": 3,
   "name": "NDM Relay",
   "permissions": [ "webRequest", "webNavigation", "cookies", "contextMenus", "storage", "downloads" ],
   "version": "1.3.3",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "img/icon16.png", "img/icon16_2x.png", "img/close16.png", "img/close16_2x.png" ]
   } ]
}
